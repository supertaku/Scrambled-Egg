{
  "name": "haki",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test:golden": "tsx scripts/golden-retrieval.ts",
    "test:seed-data": "tsx scripts/seed-data-qa.ts",
    "test:unit": "vitest run",
    "test:local-models": "tsx scripts/test-local-model-manager.ts",
    "test:edge-cases": "tsx scripts/test-edge-cases.ts",
    "test:chat-scenarios": "tsx scripts/chat-scenario-eval.ts",
    "test:all": "npm run typecheck && npm run test:unit && npm run test:seed-data && npm run test:local-models && npm run test:golden && npm run test:edge-cases && npm run test:chat-scenarios",
    "apk:inspect": "powershell -ExecutionPolicy Bypass -File scripts/inspect-apk-assets.ps1",
    "eas-build-pre-install": "bash scripts/eas-build-pre-install.sh",
    "eas-build-post-install": "bash scripts/eas-build-pre-install.sh",
    "postinstall": "node scripts/fix-expo-sqlite.js && patch-package"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-voice/voice": "^3.2.4",
    "expo": "~55.0.23",
    "expo-build-properties": "^55.0.13",
    "expo-constants": "~55.0.16",
    "expo-crypto": "~55.0.14",
    "expo-dev-client": "^55.0.32",
    "expo-document-picker": "~55.0.13",
    "expo-file-system": "~55.0.19",
    "expo-haptics": "~55.0.14",
    "expo-image-picker": "^55.0.20",
    "expo-linking": "~55.0.15",
    "expo-modules-core": "55.0.25",
    "expo-router": "~55.0.14",
    "expo-secure-store": "^55.0.13",
    "expo-sensors": "^55.0.14",
    "expo-sqlite": "55.0.15",
    "llama.rn": "0.12.0-rc.9",
    "lottie-react-native": "^7.3.6",
    "lucide-react-native": "^1.14.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-keyboard-controller": "^1.21.8",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-worklets": "0.7.4",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "babel-plugin-module-resolver": "^5.0.3",
    "patch-package": "^8.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  }
}
