# Exclude local AI model scratch files, but allow the bundled default GGUF.
assets/models/*
!assets/models/
!assets/models/README.md
android/app/src/main/assets/models/*
!android/app/src/main/assets/models/
!android/app/src/main/assets/models/haki-default.gguf

# Exclude large local data
*.pte
!app.json
!package.json
!tsconfig.json

# Machine-specific Android SDK path must never reach the EAS builder.
android/local.properties

# Standard ignores
node_modules/
tmp/
.gradle/
build/
.expo/
dist/
android/build/
android/.gradle/
android/app/build/
ios/build/
*.log

# Native artifacts
**/*.so
**/*.a
**/*.o
